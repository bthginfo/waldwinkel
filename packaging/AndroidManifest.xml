<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="game.waldwinkel"
    android:versionCode="19"
    android:versionName="1.5.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x00400000" android:required="true" />
    <application android:label="Waldwinkel"
        android:appCategory="game"
        android:icon="@drawable/icon"
        android:theme="@style/Waldwinkel"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <activity android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density|uiMode|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <meta-data android:name="android.app.lib_name" android:value="waldwinkel" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
